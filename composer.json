{
    "name": "pharaonic/laravel-hijri",
    "description": "Hijri DateTime integration for Laravel, powered by Pharaonic PHP Hijri.",
    "keywords": [
        "hijri",
        "islamic",
        "calendar",
        "laravel",
        "carbon",
        "laravel hijri",
        "php hijri"
    ],
    "homepage": "https://pharaonic.dev/packages/laravel/hijri",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com",
            "homepage": "https://pharaonic.dev",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Pharaonic/laravel-hijri/issues",
        "source": "https://github.com/Pharaonic/laravel-hijri",
        "docs": "https://pharaonic.dev/packages/laravel/hijri"
    },
    "require": {
        "php": ">=8.2 <8.5",
        "illuminate/contracts": "^11.0",
        "illuminate/support": "^11.0",
        "illuminate/view": "^11.0",
        "pharaonic/php-hijri": "~8.2.3 || ~8.3.3 || ~8.4.3"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^9.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Hijri\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Hijri\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Hijri\\HijriServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "pint --test",
        "format": "pint",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
