{
    "name": "pharaonic/laravel-hijri",
    "description": "Hijri DateTime integration for Laravel, powered by Pharaonic PHP Hijri.",
    "keywords": [
        "hijri",
        "islamic",
        "calendar",
        "laravel",
        "carbon",
        "laravel hijri",
        "php hijri"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Pharaonic/laravel-hijri/issues",
        "source": "https://github.com/Pharaonic/laravel-hijri"
    },
    "require": {
        "php": ">=8.0 <8.3",
        "illuminate/contracts": "^9.0",
        "illuminate/database": "^9.0",
        "illuminate/support": "^9.0",
        "pharaonic/php-hijri": "~8.0.3 || ~8.1.2 || ~8.2.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Hijri\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Hijri\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Hijri\\HijriServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "pint --test",
        "format": "pint",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
